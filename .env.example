# PostgreSQL connection for the app (database is created by `npm run db:setup`)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/brandon_app

# Connection used ONLY to CREATE the database above. Points at the `postgres`
# maintenance DB with a superuser. Leave unset to skip auto-create.
ADMIN_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# --- WhatsApp (dummy for now; fill in when you go live with Meta Cloud API) ---
WHATSAPP_MODE=demo
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
