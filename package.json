{
  "name": "brandon-app",
  "version": "1.0.0",
  "private": true,
  "description": "Hourly apartment rental manager — PWA",
  "scripts": {
    "dev": "next dev --port 3009",
    "build": "node scripts/gen-assets.mjs && next build",
    "start": "next start --port 3009",
    "lint": "next lint",
    "assets": "node scripts/gen-assets.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:reset": "node --env-file=.env.local scripts/setup-db.mjs --reset",
    "setup": "npm run assets && npm run db:reset"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "next": "^15.5.23",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
